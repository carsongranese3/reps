# Copy this file to server/.env and fill in your key. server/.env is gitignored.
# The server reads these; they are NEVER shipped to the client.

# Google Gemini API key (free tier is fine) — powers the exercise Autofill feature.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to use. Defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=gemini-2.0-flash
